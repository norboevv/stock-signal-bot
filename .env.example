# BotFather'dan olingan token (@BotFather -> /newbot)
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenHere

# Signal oluvchilar ro'yxati botga /start bosgan har bir kishidan avtomatik
# to'ldiriladi (data/subscribers.json) — alohida chat ID sozlash shart emas.

# Telegram webhook manzilining maxfiy qismi (taxmin qilib bo'lmaydigan tasodifiy
# satr). Generatsiya qilish uchun: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
TELEGRAM_WEBHOOK_SECRET=change-me-random-hex-string

# Ilovaning tashqi (public) manzili — Telegram webhook shu yerga ro'yxatdan
# o'tkaziladi. Https bilan, oxirida / bo'lmasin.
PUBLIC_URL=https://bot.example.com

# Tashqi cron job /api/run-cycle'ni chaqirganda ishlatadigan maxfiy token —
# tasodifiy foydalanuvchilar strategiya tsiklini ishga tushira olmasligi uchun.
# Generatsiya: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=change-me-random-hex-string

# Web dashboard portı. aHost.uz cPanel Passenger buni avtomatik PORT env
# orqali beradi, lokal ishga tushirishda 3000 ishlatiladi.
PORT=3000

# Dashboard'ga kirish uchun oddiy parol (query param yoki Basic Auth uchun)
DASHBOARD_PASSWORD=change-me
